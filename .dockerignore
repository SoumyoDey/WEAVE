# Keep the build context small and the images reproducible.
#
# Without this the context is the whole working tree — `node_modules` alone is
# several hundred MB, and it would be copied into the daemon on every build
# only to be discarded by `npm ci`.

.git
.github
node_modules
build
coverage
.env
.env.*
!.env.example

# Test and development material. None of it runs in a container, and copying it
# in means a changed test invalidates the image layer cache.
e2e
playwright-report
test-results
**/__pycache__
**/*.pyc
.pytest_cache
.coverage
htmlcov

# Documentation. The images do not serve it and it changes constantly, which is
# the worst combination for layer caching.
*.md
!README.md

# Anything large that is deliberately not in git but sits in the tree.
*.dump
*.sql.gz
*.nc
*.grib*
.weave_backup_rehearsal
