# ── Flask API environment variables  (copy to .env and fill in values) ───────
# .env is gitignored; .env.example is committed as a template.

# ── PostgreSQL connection ──────────────────────────────────────────────────────
DB_NAME=weave_weather
DB_USER=your_pg_username
DB_PASSWORD=your_pg_password
DB_HOST=localhost
DB_PORT=5432

# Connection pool size, PER GUNICORN WORKER. The number that must stay under
# PostgreSQL's max_connections (default 100) is workers × DB_POOL_MAX.
#
# 8 is safe at every worker count DEPLOY.md documents, including the 8-worker
# tier: 8 × 8 = 64 < 100. The old default of 20 only held for 4 workers and
# broke at 5+ concurrent users, which is what REVIEW_DEPLOY_PREREQS.md §2 is
# about. The API checks this against the live server at startup and reports it
# in /api/health under "connection_pool".
DB_POOL_MIN=2
DB_POOL_MAX=8

# Number of API workers, so the startup check can verify the arithmetic above.
# gunicorn reads WEB_CONCURRENCY itself, so setting it here serves both.
WEB_CONCURRENCY=4

# ── Flask server ───────────────────────────────────────────────────────────────
FLASK_PORT=5000
# Leave false everywhere except local dev — the Werkzeug debugger must never be
# reachable on a deployed instance. Set to true locally if you want auto-reload.
FLASK_DEBUG=false

# Max request body in bytes (default 16 MiB).
MAX_CONTENT_LENGTH=16777216

# ── CORS allowed origin (must match the frontend origin exactly) ──────────────
CORS_ORIGIN=http://localhost:3000
