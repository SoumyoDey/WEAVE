# ── Flask API environment variables  (copy to .env and fill in values) ───────
# .env is gitignored; .env.example is committed as a template.

# ── PostgreSQL connection ──────────────────────────────────────────────────────
DB_NAME=weave_weather
DB_USER=your_pg_username
DB_PASSWORD=your_pg_password
DB_HOST=localhost
DB_PORT=5432

# Connection pool size (per gunicorn worker). Keep workers × DB_POOL_MAX below
# PostgreSQL's max_connections (default 100). See DEPLOY.md.
DB_POOL_MIN=5
DB_POOL_MAX=20

# ── Flask server ───────────────────────────────────────────────────────────────
FLASK_PORT=5000
# Leave false everywhere except local dev — the Werkzeug debugger must never be
# reachable on a deployed instance. Set to true locally if you want auto-reload.
FLASK_DEBUG=false

# Max request body in bytes (default 16 MiB).
MAX_CONTENT_LENGTH=16777216

# ── CORS allowed origin (must match the frontend origin exactly) ──────────────
CORS_ORIGIN=http://localhost:3000
